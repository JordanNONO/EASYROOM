# Copie ce fichier en ".env" et remplis les vraies valeurs (jamais commit .env).

NODE_ENV=development
PORT=4500

# Origines autorisées pour le front (séparées par des virgules). Laisser vide = tout autoriser.
CORS_ORIGIN=

# Base de données (dev/test = MySQL local, prod = Postgres via DATABASE_URL fourni par l'hébergeur)
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=database_development
DB_NAME_TEST=database_test
DB_HOST=127.0.0.1
DATABASE_URL=

# Secrets à générer toi-même (ex: openssl rand -hex 32), à NE JAMAIS commit
SESSION_SECRET=
JWT_SECRET=

# Cloudinary (dashboard.cloudinary.com > Settings > API Keys) — À RÉGÉNÉRER après la fuite
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Chemin vers le fichier de clé de service Firebase (ne jamais commit ce fichier)
FIREBASE_SERVICE_ACCOUNT_PATH=./easyroom-firebase-adminsdk.json
